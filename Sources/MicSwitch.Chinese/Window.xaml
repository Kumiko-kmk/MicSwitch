<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="麦克风" Width="76" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#DFE7F2" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D9E4F3"/><Setter Property="Background" Value="#28384D"/><Setter Property="Padding" Value="8,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#364C67"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#364C67"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DFE7F2"/><Setter Property="Margin" Value="0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="#172232"/></Style>
 </Window.Resources>
 <Border Background="#E8141E2D" BorderBrush="#41516A" BorderThickness="1" CornerRadius="12" Padding="8">
  <StackPanel>
   <StackPanel x:Name="Indicator" Background="Transparent" ToolTip="右键设置">
    <TextBlock x:Name="MicIcon" Text="&#xF781;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="#91A3BD" HorizontalAlignment="Center" Margin="0,2,0,5"/>
    <TextBlock x:Name="LevelText" Text="−∞" FontSize="16" HorizontalAlignment="Center"/>
    <TextBlock Text="dBFS" FontSize="9" Foreground="#8CA0BB" HorizontalAlignment="Center"/>
   </StackPanel>
   <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="4,12,4,2">
    <TextBlock Text="说话热键" Margin="0,0,0,6"/><Button x:Name="BindButton" Content="点击绑定" AutomationProperties.Name="绑定说话热键"/>
    <TextBlock Text="开麦设备" Margin="0,12,0,6"/><ComboBox x:Name="DeviceChoice" AutomationProperties.Name="开麦设备"/>
    <CheckBox x:Name="BlockToggle" Content="拦截热键原功能"/>
    <CheckBox x:Name="StartToggle" Content="开机启动"/>
    <CheckBox x:Name="ExitToggle" Content="退出后保持静音"/>
    <Button x:Name="AdminButton" Content="以管理员身份重启" Margin="0,4,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CloseSettings" Content="收起" Margin="0,0,4,0"/><Button x:Name="ExitButton" Grid.Column="1" Content="退出" Margin="4,0,0,0"/></Grid>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
