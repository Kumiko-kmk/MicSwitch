<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="輕聲" Width="320" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" FontFamily="Microsoft JhengHei UI, Microsoft YaHei UI" FontSize="13" Foreground="#E8EDF5" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#58DFBD"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#C9D3E2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,7"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2C394C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2C394C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#DCE4EF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="Track" Grid.Column="1" Background="#354257" Width="32" Height="18" CornerRadius="9"><Ellipse x:Name="Thumb" Fill="#C6D1DF" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#58DFBD"/><Setter TargetName="Thumb" Property="Fill" Value="#122A27"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="Background" Value="#202C3D"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#35465D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#58DFBD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E8EDF5"/><Setter Property="Background" Value="#202C3D"/><Setter Property="Height" Value="34"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#202C3D" CornerRadius="7" BorderBrush="#354257" BorderThickness="1"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#B6C5D7"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="500" Background="#202C3D" BorderBrush="#354257" BorderThickness="1" CornerRadius="7" Padding="3"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Frame" Margin="6" Background="#141E2D" BorderBrush="#344156" BorderThickness="1" CornerRadius="16" Padding="18,14">
  <StackPanel x:Name="Body">
   <Grid x:Name="DragArea" Background="Transparent" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="輕聲" FontSize="13" Foreground="#A3B3C8" VerticalAlignment="Center"/>
    <Button x:Name="SettingsButton" Grid.Column="1" Padding="8,3" AutomationProperties.Name="設定"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15"/></Button>
    <Button x:Name="HideButton" Grid.Column="2" Padding="8,3" AutomationProperties.Name="收至系統匣"><TextBlock Text="−" FontSize="17"/></Button>
   </Grid>
   <Grid x:Name="StatusArea" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="MicCircle" Background="#263348" Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Left"><TextBlock x:Name="MicIcon" Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#97A9C1"/></Border>
    <TextBlock x:Name="StateText" Grid.Column="1" Text="連接中" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="LevelText" Grid.Column="2" Text="−∞ dBFS" Foreground="#93A6BF" FontSize="12" VerticalAlignment="Center"/>
   </Grid>
   <Canvas x:Name="Meter" Height="30" Margin="0,10,0,0" ClipToBounds="True" IsHitTestVisible="False"/>
   <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600">
   <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
    <Border Height="1" Background="#2A374A" Margin="0,14,0,14"/>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="說話按鍵" VerticalAlignment="Center"/><ComboBox x:Name="KeyChoice" Grid.Column="1" AutomationProperties.Name="說話按鍵"><ComboBoxItem Content="滑鼠側鍵 1"/><ComboBoxItem Content="滑鼠側鍵 2"/></ComboBox></Grid>
    <TextBlock Text="開麥裝置" Margin="0,0,0,8"/>
    <ComboBox x:Name="DeviceChoice" AutomationProperties.Name="開麥裝置" Margin="0,0,0,8"/>
    <CheckBox x:Name="BlockToggle" Content="攔截側鍵原功能" AutomationProperties.Name="攔截側鍵原功能"/>
    <CheckBox x:Name="TopToggle" Content="保持置頂" AutomationProperties.Name="保持置頂"/>
    <CheckBox x:Name="StartToggle" Content="開機啟動" AutomationProperties.Name="開機啟動"/>
    <CheckBox x:Name="ExitToggle" Content="退出後保持靜音" AutomationProperties.Name="退出後保持靜音"/>
    <Grid Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="不透明度" VerticalAlignment="Center"/><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="不透明度"/></Grid>
    <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="視窗大小" VerticalAlignment="Center"/><Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.85" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="視窗大小"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PrivacyButton" Content="麥克風權限" HorizontalAlignment="Left" Padding="0,8"/><Button x:Name="ExitButton" Grid.Column="1" Content="退出" Foreground="#E9A6AE"/></Grid>
   </StackPanel></ScrollViewer>
  </StackPanel>
 </Border>
</Window>
